<!-- FABRICS PRODUCTION REPORT - one row per production order. A4 landscape. Filled by ReportService from ProductionReportService rows (no query of its own). -->
<jasperReport name="fabrics-production-report" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="18" bottomMargin="18" whenNoDataType="AllSectionsNoDetail" uuid="68ad9408-51a3-4e6b-96dd-5d8979641dd3">
<style name="Base" default="true" fontName="DejaVu Sans" pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" pdfEmbedded="true" fontSize="7.0"/>
<style name="Row" mode="Transparent"><conditionalStyle mode="Opaque" backcolor="#F9FAFB"><conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression></conditionalStyle></style>
<style name="bar_lc" mode="Opaque" forecolor="#DC2626" backcolor="#DC2626"><conditionalStyle forecolor="#16A34A" backcolor="#16A34A"><conditionExpression><![CDATA[$F{lcPct} != null && $F{lcPct} >= 100]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#2563EB" backcolor="#2563EB"><conditionExpression><![CDATA[$F{lcPct} != null && $F{lcPct} >= 70]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#F59E0B" backcolor="#F59E0B"><conditionExpression><![CDATA[$F{lcPct} != null && $F{lcPct} >= 40]]></conditionExpression></conditionalStyle></style>
<style name="bar_weaving" mode="Opaque" forecolor="#DC2626" backcolor="#DC2626"><conditionalStyle forecolor="#16A34A" backcolor="#16A34A"><conditionExpression><![CDATA[$F{weavingPct} != null && $F{weavingPct} >= 100]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#2563EB" backcolor="#2563EB"><conditionExpression><![CDATA[$F{weavingPct} != null && $F{weavingPct} >= 70]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#F59E0B" backcolor="#F59E0B"><conditionExpression><![CDATA[$F{weavingPct} != null && $F{weavingPct} >= 40]]></conditionExpression></conditionalStyle></style>
<style name="bar_processing" mode="Opaque" forecolor="#DC2626" backcolor="#DC2626"><conditionalStyle forecolor="#16A34A" backcolor="#16A34A"><conditionExpression><![CDATA[$F{processingPct} != null && $F{processingPct} >= 100]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#2563EB" backcolor="#2563EB"><conditionExpression><![CDATA[$F{processingPct} != null && $F{processingPct} >= 70]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#F59E0B" backcolor="#F59E0B"><conditionExpression><![CDATA[$F{processingPct} != null && $F{processingPct} >= 40]]></conditionExpression></conditionalStyle></style>
<style name="bar_greigeReceived" mode="Opaque" forecolor="#DC2626" backcolor="#DC2626"><conditionalStyle forecolor="#16A34A" backcolor="#16A34A"><conditionExpression><![CDATA[$F{greigeReceivedPct} != null && $F{greigeReceivedPct} >= 100]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#2563EB" backcolor="#2563EB"><conditionExpression><![CDATA[$F{greigeReceivedPct} != null && $F{greigeReceivedPct} >= 70]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#F59E0B" backcolor="#F59E0B"><conditionExpression><![CDATA[$F{greigeReceivedPct} != null && $F{greigeReceivedPct} >= 40]]></conditionExpression></conditionalStyle></style>
<style name="bar_greigeIssued" mode="Opaque" forecolor="#DC2626" backcolor="#DC2626"><conditionalStyle forecolor="#16A34A" backcolor="#16A34A"><conditionExpression><![CDATA[$F{greigeIssuedPct} != null && $F{greigeIssuedPct} >= 100]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#2563EB" backcolor="#2563EB"><conditionExpression><![CDATA[$F{greigeIssuedPct} != null && $F{greigeIssuedPct} >= 70]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#F59E0B" backcolor="#F59E0B"><conditionExpression><![CDATA[$F{greigeIssuedPct} != null && $F{greigeIssuedPct} >= 40]]></conditionExpression></conditionalStyle></style>
<style name="bar_finished" mode="Opaque" forecolor="#DC2626" backcolor="#DC2626"><conditionalStyle forecolor="#16A34A" backcolor="#16A34A"><conditionExpression><![CDATA[$F{finishedPct} != null && $F{finishedPct} >= 100]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#2563EB" backcolor="#2563EB"><conditionExpression><![CDATA[$F{finishedPct} != null && $F{finishedPct} >= 70]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#F59E0B" backcolor="#F59E0B"><conditionExpression><![CDATA[$F{finishedPct} != null && $F{finishedPct} >= 40]]></conditionExpression></conditionalStyle></style>
