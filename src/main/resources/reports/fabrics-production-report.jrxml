<style name="Due" forecolor="#6B7280"><conditionalStyle forecolor="#15803D"><conditionExpression><![CDATA["COMPLETED".equals($F{dueState})]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#B91C1C"><conditionExpression><![CDATA["OVERDUE".equals($F{dueState})]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#B45309"><conditionExpression><![CDATA["DUE_SOON".equals($F{dueState})]]></conditionExpression></conditionalStyle><conditionalStyle forecolor="#15803D"><conditionExpression><![CDATA["ON_TIME".equals($F{dueState})]]></conditionExpression></conditionalStyle></style>
